(test "edit and clear a scheduled due date without changing another task"
  (steps
    (expect-date (date-picker "New due date") no-date)
    (expect-disabled (time-picker "New due time") true)
    (fill (text-field "New to-do") "First")
    (set-date (date-picker "New due date") (date 2028 2 29))
    (expect-disabled (time-picker "New due time") false)
    (set-time (time-picker "New due time") (time 9 15))
    (click (button "Add"))
    (expect-date (date-picker "New due date") no-date)
    (expect-time (time-picker "New due time") no-time)
    (expect-date (date-picker "Due date for First") (date 2028 2 29))
    (expect-time (time-picker "Due time for First") (time 9 15))
    (expect-visible (text "Due 2028-02-29 at 09:15"))
    (fill (text-field "New to-do") "Second")
    (set-date (date-picker "New due date") (date 2028 3 1))
    (set-time (time-picker "New due time") (time 23 59))
    (click (button "Add"))
    (set-date (date-picker "Due date for First") (date 2028 3 1))
    (expect-date (date-picker "Due date for First") (date 2028 3 1))
    (expect-time (time-picker "Due time for First") (time 9 15))
    (set-time (time-picker "Due time for First") no-time)
    (expect-time (time-picker "Due time for First") no-time)
    (expect-visible (text "Due 2028-03-01"))
    (set-time (time-picker "Due time for First") (time 0 0))
    (set-date (date-picker "Due date for First") no-date)
    (expect-date (date-picker "Due date for First") no-date)
    (expect-time (time-picker "Due time for First") no-time)
    (expect-disabled (time-picker "Due time for First") true)
    (expect-date (date-picker "Due date for Second") (date 2028 3 1))
    (expect-time (time-picker "Due time for Second") (time 23 59))
    (expect-visible (text "Due 2028-03-01 at 23:59"))))
