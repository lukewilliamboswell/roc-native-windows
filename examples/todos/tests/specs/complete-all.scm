(test "complete all visible tasks"
  (steps
    (expect-disabled (checkbox "Complete all visible tasks") true)
    (expect-checked (checkbox "Complete all visible tasks") false)
    (fill (text-field "New to-do") "First")
    (click (button "Add"))
    (fill (text-field "New to-do") "Second")
    (click (button "Add"))
    (expect-disabled (checkbox "Complete all visible tasks") false)
    (toggle (checkbox "First"))
    (expect-checked (checkbox "Complete all visible tasks") mixed)
    (toggle (checkbox "Complete all visible tasks"))
    (expect-checked (checkbox "Complete all visible tasks") true)
    (expect-checked (checkbox "Second") true)
    (expect-visible (text "0 remaining"))
    (toggle (checkbox "Complete all visible tasks"))
    (expect-checked (checkbox "Complete all visible tasks") false)
    (expect-checked (checkbox "First") false)
    (expect-visible (text "2 remaining"))))
