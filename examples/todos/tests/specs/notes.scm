(test "save and dismiss an owned notes dialog"
  (steps
    (fill (text-field "New to-do") "First")
    (click (button "Add"))
    (fill (text-field "New to-do") "Second")
    (click (button "Add"))
    (expect-absent (dialog "Notes for First"))
    (click (button "Notes for First"))
    (expect-text (within (dialog "Notes for First") (text-area "Notes")) "")
    (fill (within (dialog "Notes for First") (text-area "Notes")) "First line\n  Indented second line")
    (click (within (dialog "Notes for First") (button "Save notes")))
    (expect-absent (dialog "Notes for First"))
    (click (button "Notes for First"))
    (expect-text (within (dialog "Notes for First") (text-area "Notes")) "First line\n  Indented second line")
    (fill (within (dialog "Notes for First") (text-area "Notes")) "Unsaved cancellation")
    (click (within (dialog "Notes for First") (button "Cancel")))
    (click (button "Notes for First"))
    (expect-text (within (dialog "Notes for First") (text-area "Notes")) "First line\n  Indented second line")
    (fill (within (dialog "Notes for First") (text-area "Notes")) "Unsaved dismissal")
    (dismiss (dialog "Notes for First"))
    (expect-absent (dialog "Notes for First"))
    (click (button "Notes for Second"))
    (expect-text (within (dialog "Notes for Second") (text-area "Notes")) "")
    (dismiss (dialog "Notes for Second"))
    (click (button "Notes for First"))
    (expect-text (within (dialog "Notes for First") (text-area "Notes")) "First line\n  Indented second line")
    (dismiss (dialog "Notes for First"))))
