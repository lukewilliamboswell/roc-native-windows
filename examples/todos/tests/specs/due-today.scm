(test "due today follows local midnight on both sides of daylight saving"
  (setup
    (initial-time 1805000399999)
    (regional-fixture "tests/fixtures/eastern-spring.txt"))
  (steps
    (expect-interval 60000 1)
    (fill (text-field "New to-do") "March review")
    (set-date (date-picker "New due date") (date 2027 3 14))
    (click (button "Add"))
    (expect-visible (text "Due 2027-03-14"))
    (advance-time 1)
    (tick-interval 60000)
    (expect-visible (text "Due today"))
    (set-wall-time 1805007599999)
    (tick-interval 60000)
    (expect-visible (text "Due today"))
    (advance-time 1)
    (tick-interval 60000)
    (expect-visible (text "Due today"))
    (set-wall-time 1805083199999)
    (tick-interval 60000)
    (expect-visible (text "Due today"))
    (advance-time 1)
    (tick-interval 60000)
    (expect-visible (text "Due 2027-03-14"))))
