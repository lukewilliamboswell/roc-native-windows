(test "Civil dates commit a valid draft and keep invalid text until cancelled"
  (steps
    (fill (date-field "New due date") "2000-02-29")
    (expect-date (date-field "New due date") no-date)
    (press-enter (date-field "New due date"))
    (expect-date (date-field "New due date") (date 2000 2 29))
    (fill (date-field "New due date") "1900-02-29")
    (press-enter (date-field "New due date"))
    (expect-invalid (date-field "New due date") true)
    (expect-text (date-field "New due date") "1900-02-29")
    (expect-date (date-field "New due date") (date 2000 2 29))
    (press-escape (date-field "New due date"))
    (expect-invalid (date-field "New due date") false)
    (expect-date (date-field "New due date") (date 2000 2 29))
    (fill (time-field "New due time") "23:15")
    (press-enter (time-field "New due time"))
    (expect-time (time-field "New due time") (time 23 15))
    (fill (time-field "New due time") "24:01")
    (press-enter (time-field "New due time"))
    (expect-invalid (time-field "New due time") true)
    (expect-time (time-field "New due time") (time 23 15))
    (press-escape (time-field "New due time"))
    (expect-invalid (time-field "New due time") false)
    (fill (date-field "New due date") "")
    (press-enter (date-field "New due date"))
    (expect-date (date-field "New due date") no-date)
    (expect-time (time-field "New due time") no-time)))
