(test "select, sort, read and remove titles"
  (steps
    (expect-visible (text "0 unread"))
    (expect-list-rows (list-view "Titles"))
    (expect-row-selected (list-view "Titles") "")
    (expect-disabled (button "Mark read") true)
    (expect-disabled (button "Remove") true)
    (fill (text-field "Title") "  Roc guide  ")
    (click (button "Add"))
    (expect-row-selected (list-view "Titles") "Roc guide")
    (fill (text-field "Title") "Roc guide")
    (click (button "Add"))
    (expect-list-rows (list-view "Titles") "Roc guide")
    (fill (text-field "Title") "API guide")
    (click (button "Add"))
    (expect-visible (text "2 unread"))
    (expect-list-rows (list-view "Titles") "Roc guide" "API guide")
    (expect-row-selected (list-view "Titles") "API guide")
    (select-row (list-view "Titles") "Roc guide")
    (press-column (list-view "Titles") "title")
    (expect-list-rows (list-view "Titles") "API guide" "Roc guide")
    (expect-row-selected (list-view "Titles") "Roc guide")
    (click (button "Mark read"))
    (expect-visible (text "1 unread"))
    (select (combo-box "Status filter") "unread")
    (expect-selection (combo-box "Status filter") "unread")
    (expect-list-rows (list-view "Titles") "API guide")
    (expect-row-selected (list-view "Titles") "")
    (select (combo-box "Status filter") "read")
    (expect-list-rows (list-view "Titles") "Roc guide")
    (select (combo-box "Status filter") "all")
    (expect-row-selected (list-view "Titles") "Roc guide")
    (activate-row (list-view "Titles") "Roc guide")
    (expect-visible (text "2 unread"))
    (click (button "Remove"))
    (expect-list-rows (list-view "Titles") "API guide")
    (expect-row-selected (list-view "Titles") "")
    (expect-disabled (button "Remove") true)))
