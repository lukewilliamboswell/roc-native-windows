(test "show a simulated HTTP reply and a virtual timeout"
  (steps
    (expect-progress (progress-bar "Request progress") idle)
    (fill (text-field "URL") " ")
    (press-enter (text-field "URL"))
    (expect-pending-effects 0)
    (fill (text-field "URL") "https://example.test/guide")
    (press-enter (text-field "URL"))
    (expect-pending-effects 1)
    (expect-taskbar-progress indeterminate)
    (expect-progress (progress-bar "Request progress") indeterminate)
    (expect-visible (text "Fetching…"))
    (expect-request 1 :method "GET" :url "https://example.test/guide" :timeout 15000)
    (stub-http "guide" :url "https://example.test/guide" :status 200 :body "Read the guide.")
    (random-bytes 1 "tests/fixtures/request-reference.bin")
    (set-wall-time -1000)
    (advance-time 215)
    (run-effect 1)
    (expect-taskbar-progress idle)
    (expect-progress (progress-bar "Request progress") idle)
    (expect-visible (text "HTTP 200 · 15 bytes · 215 ms"))
    (expect-visible (text "Read the guide."))
    (click (button "Copy request details"))
    (expect-clipboard 1 "HTTP 200 · 15 bytes\nElapsed: 215 ms\nReference: 30313233343536373839616263646566")
    (click (button "Fetch"))
    (expect-request 2 :url "https://example.test/guide")
    (expect-progress (progress-bar "Request progress") indeterminate)
    (fail-random 2 failed)
    (advance-time 15000)
    (expect-taskbar-progress idle)
    (expect-progress (progress-bar "Request progress") idle)
    (expect-visible (text "The request timed out."))
    (click (button "Copy request details"))
    (expect-clipboard 2 "The request timed out.\nElapsed: 15000 ms\nReference: unavailable")))
