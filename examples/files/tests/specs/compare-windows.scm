(test "compare files in two independent windows"
  (steps
    (files "tests/fixtures/hello.txt" "tests/fixtures/second/hello.txt")
    (await-work)
    (click (within (window "Files") (button "Open in New Window")))
    (expect-visible (window "Compare hello.txt"))
    (await-work)
    (expect-text (within (window "Compare hello.txt") (text-area "Contents")) "hello\n  from a fixture\n")
    (select (within (window "Files") (list-box "Picked files")) "2")
    (await-work)
    (expect-text (within (window "Files") (text-area "Contents")) "other\n")
    (select (within (window "Compare hello.txt") (tabs "File details")) "fingerprint")
    (expect-visible (within (window "Compare hello.txt") (text "SHA-256: 64fa48697ba62a5afa31a7000d648de9a0dd395484cb88bfff1fa3628ab6bc83")))
    (expect-selection (within (window "Files") (tabs "File details")) "preview")
    (close-window (window "Compare hello.txt"))
    (expect-absent (window "Compare hello.txt"))
    (expect-text (within (window "Files") (text-area "Contents")) "other\n")
    (click (within (window "Files") (button "Open in New Window")))
    (await-work)
    (expect-selection (within (window "Compare hello.txt") (tabs "File details")) "preview")
    (expect-text (within (window "Compare hello.txt") (text-area "Contents")) "other\n")
    (close-window (window "Compare hello.txt"))
    (close-window (window "Files"))
    (expect-exit)))
