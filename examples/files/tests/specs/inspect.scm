(test "select, preview and clear a file"
  (steps
    (expect-selection (tabs "File details") "preview")
    (files "tests/fixtures/hello.txt")
    (await-work)
    (expect-visible (text "hello.txt"))
    (expect-visible (text "23 bytes"))
    (files)
    (expect-visible (text "hello.txt"))
    (expect-visible (text "23 bytes"))
    (expect-text (text-area "Contents") "hello\n  from a fixture\n")
    (select (tabs "File details") "fingerprint")
    (expect-selection (tabs "File details") "fingerprint")
    (expect-absent (text-area "Contents"))
    (expect-visible (text "SHA-256: 64fa48697ba62a5afa31a7000d648de9a0dd395484cb88bfff1fa3628ab6bc83"))
    (select (tabs "File details") "preview")
    (expect-text (within (tabs "File details") (text-area "Contents")) "hello\n  from a fixture\n")
    (expect-absent (button "Copy SHA-256"))
    (click (button "Clear"))
    (expect-visible (text "Choose a file to preview its contents."))
    (expect-absent (text "hello.txt"))
    (expect-text (text-area "Contents") "")
    (select (tabs "File details") "fingerprint")
    (expect-disabled (button "Copy SHA-256") true)
    (expect-absent (text "SHA-256: 64fa48697ba62a5afa31a7000d648de9a0dd395484cb88bfff1fa3628ab6bc83"))))
