(test "compare an app-produced raster with a picked image"
  (setup (window-size 700 475))
  (steps
    (files "tests/fixtures/inspection.png" "tests/fixtures/hello.txt")
    (await-work)
    (select (combo-box "Image view") "calibration")
    (await-work)
    (expect-visible (image "Calibration reference"))
    (screenshot "calibration")
    (select (combo-box "Image view") "contrast")
    (await-work)
    (expect-shader (shader-view "Contrast-adjusted image") "rendered")
    (expect-shader-pixel (shader-view "Contrast-adjusted image") 12 8 "#182c47" 3)
    (set-slider (slider "Contrast") 70)
    (key-press (slider "Contrast") "ArrowRight")
    (expect-slider (slider "Contrast") 71)
    (await-work)
    (expect-shader (shader-view "Contrast-adjusted image") "rendered")
    (expect-shader-pixel (shader-view "Contrast-adjusted image") 12 8 "#00092f" 3)
    (select (combo-box "Image view") "compare")
    (await-work)
    (expect-shader (shader-view "Image comparison") "rendered")
    (set-slider (slider "Comparison divider") 0)
    (await-work)
    (expect-shader-pixel (shader-view "Image comparison") 12 8 "#102038" 3)
    (pointer-down (shader-view "Image comparison") 4000 5000)
    (pointer-move (shader-view "Image comparison") 3000 5000 7000 5000)
    (pointer-up (shader-view "Image comparison") outside)
    (expect-slider (slider "Comparison divider") 70)
    (expect-visible (text "Comparison divider: 70%"))
    (key-press (slider "Comparison divider") "ArrowLeft")
    (expect-slider (slider "Comparison divider") 69)
    (await-work)
    (expect-shader-pixel (shader-view "Image comparison") 12 8 "#182c47" 3)
    (screenshot "comparison")
    (pointer-down (shader-view "Image comparison") 2000 5000)
    (pointer-move (shader-view "Image comparison") 8000 5000)
    (select (list-box "Picked files") "2")
    (await-work)
    (expect-absent (shader-view "Image comparison"))
    (expect-text (text-area "Contents") "hello\n  from a fixture\n")))
