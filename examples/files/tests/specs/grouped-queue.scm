(test "group mixed files and retain the selected file across views"
  (steps
    (files "tests/fixtures/hello.txt" "tests/fixtures/second/hello.txt" "tests/fixtures/field-guide.md")
    (await-work)
    (expect-selection (list-box "Picked files") "1")
    (toggle (checkbox "Group by file type"))
    (expect-absent (list-box "Picked files"))
    (expect-selection (tree-view "Picked files") "1")
    (expect-expanded (tree-view "Picked files") "type:txt" true)
    (expect-expanded (tree-view "Picked files") "type:md" false)
    (collapse (tree-view "Picked files") "type:txt")
    (expect-expanded (tree-view "Picked files") "type:txt" false)
    (expect-selection (tree-view "Picked files") "")
    (expect-text (text-area "Contents") "hello\n  from a fixture\n")
    (expand (tree-view "Picked files") "type:txt")
    (expect-selection (tree-view "Picked files") "1")
    (expand (tree-view "Picked files") "type:md")
    (select (tree-view "Picked files") "2")
    (select (tree-view "Picked files") "3")
    (await-work)
    (expect-visible (text "field-guide.md"))
    (expect-text (text-area "Contents") "# Field guide\n  Keep the markdown preview.\n")
    (select (tabs "File details") "fingerprint")
    (expect-visible (text "SHA-256: 355a99cd822f2493701de4c675f74f461db1f17a50c3a6358be6c0da1b7b8333"))
    (select (tree-view "Picked files") "type:md")
    (expect-visible (text ".md (1)"))
    (toggle (checkbox "Group by file type"))
    (expect-absent (tree-view "Picked files"))
    (expect-selection (list-box "Picked files") "3")
    (expect-selection (tabs "File details") "fingerprint")
    (select (tabs "File details") "preview")
    (expect-text (text-area "Contents") "# Field guide\n  Keep the markdown preview.\n")
    (click (button "Clear"))
    (expect-selection (list-box "Picked files") "")))
