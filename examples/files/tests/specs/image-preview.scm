(test "preview selected PNG and JPEG and keep the original fingerprint"
  (setup (window-size 700 475))
  (steps
    (expect-visible (image "A document in a folder"))
    (drop-files (file-drop-target "Drop files here") "tests/fixtures/inspection.png" "tests/fixtures/hello.txt" "tests/fixtures/inspection.jpg" "tests/fixtures/unreadable.png")
    (select (list-box "Picked files") "2")
    (await-work)
    (expect-absent (image "Original image"))
    (expect-text (text-area "Contents") "hello\n  from a fixture\n")
    (select (list-box "Picked files") "1")
    (await-work)
    (expect-visible (text "Image ready"))
    (expect-visible (image "Original image"))
    (screenshot "selected-png")
    (select (tabs "File details") "fingerprint")
    (expect-visible (text "SHA-256: 5ca23288beca865504584fe189851db0ef1cf3a32fa0bc0297d41afcd9380247"))
    (select (tabs "File details") "preview")
    (select (list-box "Picked files") "3")
    (await-work)
    (expect-visible (text "Image ready"))
    (screenshot "selected-jpeg")
    (click (button "Open in New Window"))
    (await-work)
    (expect-visible (within (window "Compare inspection.jpg") (image "Original image")))
    (expect-visible (within (window "Compare inspection.jpg") (text "Image ready")))
    (close-window (window "Compare inspection.jpg"))
    (select (list-box "Picked files") "4")
    (await-work)
    (expect-visible (text "Could not preview image: UnsupportedFormat"))
    (expect-absent (text "Image ready"))))
