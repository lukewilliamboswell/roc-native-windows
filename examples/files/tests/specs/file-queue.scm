(test "switch between same-name files and retain the preview format"
  (steps
    (expect-selection (list-box "Picked files") "")
    (files "tests/fixtures/hello.txt" "tests/fixtures/second/hello.txt")
    (expect-selection (list-box "Picked files") "1")
    (select (list-box "Picked files") "2")
    (expect-selection (list-box "Picked files") "2")
    (await-work)
    (expect-visible (text "hello.txt"))
    (expect-visible (text "6 bytes"))
    (expect-text (text-area "Contents") "other\n")
    (select (tabs "File details") "fingerprint")
    (expect-visible (text "SHA-256: 7e4fa2eb8c7ac089739d5defc4489fad68a100d92082ca35c6b40a4524821f87"))
    (select (tabs "File details") "preview")
    (select (radio-group "Preview format") "hex")
    (expect-selection (radio-group "Preview format") "hex")
    (expect-text (text-area "Contents") "6f746865720a")
    (select (list-box "Picked files") "1")
    (await-work)
    (expect-text (text-area "Contents") "68656c6c6f0a202066726f6d206120666978747572650a")
    (select (tabs "File details") "fingerprint")
    (expect-visible (text "SHA-256: 64fa48697ba62a5afa31a7000d648de9a0dd395484cb88bfff1fa3628ab6bc83"))
    (select (tabs "File details") "preview")
    (files "tests/fixtures/second/hello.txt")
    (expect-selection (list-box "Picked files") "3")
    (expect-selection (radio-group "Preview format") "hex")
    (await-work)
    (expect-text (text-area "Contents") "6f746865720a")
    (click (button "Clear"))
    (expect-selection (list-box "Picked files") "")
    (expect-text (text-area "Contents") "")))
