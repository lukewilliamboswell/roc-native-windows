(demo "Inspect a text file"
  (setup (window-size 480 680))
  (steps
    (wait 600)
    (drop-files (file-drop-target "Drop files here") "tests/fixtures/hello.txt")
    (await-work)
    (expect-visible (text "hello.txt"))
    (expect-visible (text "23 bytes"))
    (expect-text (text-area "Contents") "hello\n  from a fixture\n")
    (wait 1200)
    (select (tabs "File details") "fingerprint")
    (expect-disabled (button "Copy SHA-256") false)
    (wait 1000)
    (select (tabs "File details") "preview")
    (wait 700)
    (click (within (window "Files") (button "Open in New Window")))
    (await-work)
    (screenshot (window "Compare hello.txt") "comparison")
    (close-window (window "Compare hello.txt"))
    (click (button "Clear"))
    (wait 450)))
