(demo "Inspect a scan and compare it with a calibration image"
  (setup (window-size 680 500))
  (steps
    (drop-files (file-drop-target "Drop files here") "tests/fixtures/inspection.png")
    (await-work)
    (expect-visible (text "Image ready"))
    (wait 800)
    (select (combo-box "Image view") "contrast")
    (await-work)
    (wait 500)
    (set-slider (slider "Contrast") 72)
    (await-work)
    (wait 850)
    (select (combo-box "Image view") "compare")
    (await-work)
    (wait 650)
    (pointer-down (shader-view "Image comparison") 5000 5000)
    (pointer-move (shader-view "Image comparison") 6000 5000)
    (wait 240)
    (pointer-move (shader-view "Image comparison") 7400 5000)
    (pointer-up (shader-view "Image comparison") outside)
    (await-work)
    (expect-slider (slider "Comparison divider") 74)
    (wait 1050)
    (select (tabs "File details") "fingerprint")
    (expect-visible (text "SHA-256: 5ca23288beca865504584fe189851db0ef1cf3a32fa0bc0297d41afcd9380247"))
    (wait 1050)))
