(test "browse immediate folder files and replace superseded choices"
  (steps
    (folder "tests/fixtures/folders/empty")
    (await-work)
    (expect-visible (text "empty contains no files."))
    (expect-selection (list-box "Picked files") "")
    (folder "tests/fixtures/folders/populated")
    (await-work)
    (expect-visible (text "Opened 2 files from populated."))
    (expect-selection (list-box "Picked files") "1")
    (expect-visible (text "hello.txt"))
    (expect-visible (text "23 bytes"))
    (select (list-box "Picked files") "2")
    (await-work)
    (expect-visible (text "Été.txt"))
    (expect-visible (text "12 bytes"))
    (folder)
    (expect-selection (list-box "Picked files") "2")
    (folder "tests/fixtures/folders/partial")
    (await-work)
    (expect-visible (text "Opened 16 files from partial. Some entries were omitted."))
    (expect-visible (text "item-01.txt"))
    (expect-visible (text "8 bytes"))
    (folder "tests/fixtures/folders/populated")
    (files "tests/fixtures/second/hello.txt")
    (await-work)
    (expect-visible (text "hello.txt"))
    (expect-visible (text "6 bytes"))
    (expect-absent (text "Opened 2 files from populated."))
    (folder "tests/fixtures/folders/missing")
    (expect-visible (text "Could not open the selected folder."))
    (expect-visible (text "hello.txt"))
    (expect-visible (text "6 bytes"))))
