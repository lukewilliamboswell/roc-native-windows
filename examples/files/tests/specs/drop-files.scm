(test "route Explorer drops through the same file queue"
  (steps
    (files "tests/fixtures/hello.txt")
    (await-work)
    (expect-selection (list-box "Picked files") "1")
    (drop-files-outside "tests/fixtures/field-guide.md")
    (await-work)
    (expect-selection (list-box "Picked files") "1")
    (expect-visible (text "hello.txt"))
    (drop-files (file-drop-target "Drop files here") "tests/fixtures/field-guide.md" "tests/fixtures/hello.txt")
    (await-work)
    (expect-selection (list-box "Picked files") "2")
    (expect-visible (text "field-guide.md"))
    (expect-text (text-area "Contents") "# Field guide\n  Keep the markdown preview.\n")
    (select (list-box "Picked files") "3")
    (await-work)
    (expect-text (text-area "Contents") "hello\n  from a fixture\n")
    (drop-files (file-drop-target "Drop files here") "tests/fixtures/missing.txt")
    (expect-visible (text "Could not open the selected file."))
    (files "tests/fixtures/hello.txt")
    (await-work)
    (expect-visible (text "hello.txt"))))
