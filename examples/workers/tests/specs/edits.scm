(test "normalize, reject, retry and cancel a count"
  (steps
    (expect-cell-text (data-grid "Stock counts") 1 "counted" "4")
    (begin-cell (data-grid "Stock counts") 1 "counted")
    (fill-cell (data-grid "Stock counts") "-2")
    (commit-cell (data-grid "Stock counts"))
    (expect-cell-text (data-grid "Stock counts") 1 "counted" "4")
    (expect-cell-feedback (data-grid "Stock counts") 1 "counted" "Enter a whole number from 0 to 1,000,000.")
    (expect-cell-focused (data-grid "Stock counts") 1 "counted")
    (begin-cell (data-grid "Stock counts") 1 "counted")
    (fill-cell (data-grid "Stock counts") " 04 ")
    (commit-cell (data-grid "Stock counts"))
    (expect-cell-text (data-grid "Stock counts") 1 "counted" "4")
    (expect-cell-feedback (data-grid "Stock counts") 1 "counted" "")
    (begin-cell (data-grid "Stock counts") 1 "counted")
    (commit-cell (data-grid "Stock counts"))
    (expect-cell-text (data-grid "Stock counts") 1 "counted" "4")
    (begin-cell (data-grid "Stock counts") 1 "counted")
    (fill-cell (data-grid "Stock counts") "8")
    (cancel-cell (data-grid "Stock counts"))
    (expect-cell-text (data-grid "Stock counts") 1 "counted" "4")))
