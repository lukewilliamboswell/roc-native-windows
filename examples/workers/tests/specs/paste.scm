(test "paste one validated rectangle and reject invalid batches atomically"
  (steps
    (select-cell-range (data-grid "Stock counts") 2 "counted" 1 "counted")
    (paste-grid (data-grid "Stock counts") "6\n10\n")
    (expect-cell-text (data-grid "Stock counts") 1 "counted" "6")
    (expect-cell-text (data-grid "Stock counts") 2 "counted" "10")
    (paste-grid (data-grid "Stock counts") "11\n-2")
    (expect-visible (text "Enter a whole number from 0 to 1,000,000."))
    (expect-cell-text (data-grid "Stock counts") 1 "counted" "6")
    (expect-cell-text (data-grid "Stock counts") 2 "counted" "10")
    (paste-grid (data-grid "Stock counts") "9")
    (expect-visible (text "The pasted cells must match the selected rectangle."))
    (focus-cell (data-grid "Stock counts") 2 "counted")
    (paste-grid (data-grid "Stock counts") "8\n9\n10")
    (expect-visible (text "The paste does not fit the mounted grid."))
    (focus-cell (data-grid "Stock counts") 1 "expected")
    (paste-grid (data-grid "Stock counts") "8\t9")
    (expect-visible (text "The paste includes a read-only cell."))
    (expect-cell-text (data-grid "Stock counts") 1 "expected" "4")
    (expect-cell-text (data-grid "Stock counts") 1 "counted" "6")
    (paste-grid (data-grid "Stock counts") "8\t9\n10")
    (expect-visible (text "Paste a rectangular set of tab-separated values."))
    (click (button "Reverse order"))
    (focus-cell (data-grid "Stock counts") 2 "counted")
    (paste-grid (data-grid "Stock counts") "5\n12")
    (expect-cell-text (data-grid "Stock counts") 2 "item" "Folders")
    (expect-cell-text (data-grid "Stock counts") 2 "counted" "5")
    (expect-cell-text (data-grid "Stock counts") 3 "item" "Labels")
    (expect-cell-text (data-grid "Stock counts") 3 "counted" "12")))
