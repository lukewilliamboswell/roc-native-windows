(test "edit the same mounted row after sorting and discard a filtered draft"
  (steps
    (begin-cell (data-grid "Stock counts") 2 "counted")
    (fill-cell (data-grid "Stock counts") "11")
    (click (button "Reverse order"))
    (expect-cell-text (data-grid "Stock counts") 3 "item" "Labels")
    (expect-cell-focused (data-grid "Stock counts") 3 "counted")
    (commit-cell (data-grid "Stock counts"))
    (expect-cell-text (data-grid "Stock counts") 3 "counted" "11")
    (begin-cell (data-grid "Stock counts") 2 "counted")
    (fill-cell (data-grid "Stock counts") "99")
    (click (button "Mismatches only"))
    (commit-cell (data-grid "Stock counts"))
    (expect-cell-text (data-grid "Stock counts") 1 "item" "Labels")
    (expect-cell-text (data-grid "Stock counts") 1 "counted" "11")
    (click (button "All items"))
    (expect-cell-text (data-grid "Stock counts") 2 "counted" "3")
    (click (button "Next page"))
    (expect-cell-text (data-grid "Stock counts") 1 "item" "Paper")
    (expect-cell-text (data-grid "Stock counts") 1 "counted" "4")))
