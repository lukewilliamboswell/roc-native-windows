(demo "Count stock and reconcile a snapshot"
  (setup (window-size 560 430))
  (steps
    (wait 450)
    (begin-cell (data-grid "Stock counts") 1 "counted")
    (fill-cell (data-grid "Stock counts") "-2")
    (wait 350)
    (commit-cell (data-grid "Stock counts"))
    (wait 650)
    (begin-cell (data-grid "Stock counts") 1 "counted")
    (fill-cell (data-grid "Stock counts") "7")
    (wait 450)
    (commit-cell (data-grid "Stock counts"))
    (select-cell-range (data-grid "Stock counts") 1 "counted" 2 "counted")
    (wait 350)
    (paste-grid (data-grid "Stock counts") "7\n10")
    (wait 400)
    (click (button "Reconcile"))
    (await-work)
    (expect-visible (text "Submitted snapshot: 2 matched, 0 short, 5 surplus."))
    (wait 1250)))
