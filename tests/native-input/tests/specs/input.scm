(test "coalesce movement, preserve release and modal cancellation, and drive the native slider"
  (steps
    (expect-slider (slider "Divider") 35)
    (key-press (slider "Divider") "ArrowRight")
    (expect-slider (slider "Divider") 42)
    (set-slider (slider "Divider") 99)
    (expect-slider (slider "Divider") 42)
    (pointer-down (image "Pointer") 2500 5000)
    (pointer-move (image "Pointer") 2800 5000 4700 5000 outside 9000 5000)
    (pointer-up (image "Pointer") outside)
    (expect-visible (text "D2500 M9000 UO"))
    (expect-slider (slider "Divider") 90)
    (key-press (image "Pointer") "ArrowLeft")
    (key-press (image "Pointer") "ArrowRight")
    (expect-visible (text "D2500 M9000 UO ArrowRight"))
    (pointer-down (image "Pointer") 5000 5000)
    (pointer-cancel (image "Pointer"))
    (pointer-cancel (image "Pointer"))
    (expect-visible (text "D2500 M9000 UO ArrowRight D5000 CO"))
    (pointer-down (image "Pointer") 6000 5000)
    (click (button "Open modal"))
    (expect-disabled (window "Input fixture") true)
    (dismiss (dialog "Modal"))
    (expect-visible (text "D2500 M9000 UO ArrowRight D5000 CO D6000 CO"))
    (pointer-down (image "Pointer") 7000 5000)
    (click (button "Remount"))
    (expect-visible (text "D2500 M9000 UO ArrowRight D5000 CO D6000 CO D7000"))
    (pointer-move (image "Pointer") 1000 5000 3000 5000)
    (expect-visible (text "D2500 M9000 UO ArrowRight D5000 CO D6000 CO D7000 M3000"))
    (expect-slider (slider "Divider") 30)))
